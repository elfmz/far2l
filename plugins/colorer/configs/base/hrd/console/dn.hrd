<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hrd PUBLIC "-//Cail Lomecb//DTD Colorer HRD take5//EN"
  "http://colorer.sf.net/2003/hrd.dtd">
<hrd xmlns="http://colorer.sf.net/2003/hrd">
  <documentation>
    Dos Navigator (FAR palette from farcolors.ini), 16-color console approximation.
  </documentation>

  <assign name="def:Text" fore="#7" back="#8"/>
  <assign name="def:HorzCross" fore="#F" back="#3"/>
  <assign name="def:VertCross" fore="#E" back="#1"/>

  <assign name="def:Number" fore="#B"/>
  <assign name="def:NumberDec" fore="#B"/>
  <assign name="def:NumberHex" fore="#B"/>
  <assign name="def:NumberBin" fore="#B"/>
  <assign name="def:NumberOct" fore="#B"/>
  <assign name="def:NumberFloat" fore="#B"/>
  <assign name="def:NumberSuffix" fore="#3"/>
  <assign name="def:NumberPrefix" fore="#3"/>

  <assign name="def:String" fore="#4"/>
  <assign name="def:StringContent" fore="#E"/>
  <assign name="def:StringEdge" fore="#4"/>
  <assign name="def:Character" fore="#4"/>
  <assign name="def:CharacterContent" fore="#4"/>

  <assign name="def:Comment" fore="#3"/>
  <assign name="def:CommentContent" fore="#B"/>
  <assign name="def:CommentEdge" fore="#3"/>
  <assign name="def:LineComment" fore="#3"/>
  <assign name="def:CommentDoc" fore="#1"/>
  <assign name="def:CommentDocContent" fore="#B"/>
  <assign name="def:CommentDocEdge" fore="#1"/>

  <assign name="def:Symbol" fore="#F"/>
  <assign name="def:SymbolStrong" fore="#E"/>
  <assign name="def:Prefix" fore="#1"/>
  <assign name="def:PrefixStrong" fore="#3"/>
  <assign name="def:Operator" fore="#2"/>

  <assign name="def:Keyword" fore="#E" style='1'/>
  <assign name="def:KeywordStrong" fore="#F" style='1'/>
  <assign name="def:FunctionKeyword" fore="#E" style='1'/>
  <assign name="def:DeprecatedKeyword" fore="#0" style='4'/>
  <assign name="def:InterfaceKeyword" fore="#F"/>
  <assign name="def:ClassKeyword" fore="#E"/>
  <assign name="def:StructKeyword" fore="#E"/>
  <assign name="def:TypeKeyword" fore="#F"/>

  <assign name="def:Function" fore="#B"/>
  <assign name="def:Register" fore="#B"/>
  <assign name="def:Constant" fore="#B"/>
  <assign name="def:BooleanConstant" fore="#E"/>
  <assign name="def:Var" fore="#7"/>
  <assign name="def:VarStrong" fore="#F"/>
  <assign name="def:Identifier" fore="#7"/>

  <assign name="def:Directive" fore="#2"/>
  <assign name="def:DirectiveContent" fore="#2"/>
  <assign name="def:DirectiveEdge" fore="#2"/>
  <assign name="def:Parameter" fore="#B"/>
  <assign name="def:ParameterStrong" fore="#E"/>
  <assign name="def:ParameterUnknown" fore="#4"/>

  <assign name="def:Tag" fore="#E"/>
  <assign name="def:OpenTag" fore="#E"/>
  <assign name="def:CloseTag" fore="#E"/>
  <assign name="def:EmbeddedTag" fore="#F"/>

  <assign name="def:Label" fore="#4"/>
  <assign name="def:LabelStrong" fore="#0" back="#E"/>

  <assign name="def:Insertion" fore="#F" back="#0"/>
  <assign name="def:InsertionStart" fore="#E" back="#3"/>
  <assign name="def:InsertionEnd" fore="#E" back="#3"/>
  <assign name="def:InsertionEmbed" fore="#F" back="#0"/>

  <assign name="def:Error" fore="#F" back="#4" style='1'/>
  <assign name="def:ErrorText" fore="#4"/>
  <assign name="def:TODO" fore="#0" back="#E" style='1'/>
  <assign name="def:Debug" fore="#E" back="#1"/>

  <assign name="def:URI" fore="#1" style='4'/>
  <assign name="def:URL" fore="#1" style='4'/>
  <assign name="def:Path" fore="#B"/>
  <assign name="def:EMail" fore="#1" style='4'/>

  <assign name="def:Date" fore="#B"/>
  <assign name="def:Time" fore="#2"/>

  <assign name="def:PairStart" fore="#0" back="#3"/>
  <assign name="def:PairEnd" fore="#0" back="#3"/>
  <assign name="def:PairStrongStart" fore="#0" back="#E"/>
  <assign name="def:PairStrongEnd" fore="#0" back="#E"/>
</hrd>
