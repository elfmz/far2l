<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hrd PUBLIC "-//Cail Lomecb//DTD Colorer HRD take5//EN"
  "http://colorer.sf.net/2003/hrd.dtd">
<hrd xmlns="http://colorer.sf.net/2003/hrd">
  <documentation>
    Nord (Arctic Ice Studio).
  </documentation>

  <assign name="def:Text" fore="#d8dee9" back="#2e3440"/>
  <assign name="def:HorzCross" fore="#d8dee9" back="#3b4252"/>
  <assign name="def:VertCross" fore="#d8dee9" back="#3b4252"/>

  <assign name="def:Number" fore="#b48ead"/>
  <assign name="def:NumberDec" fore="#b48ead"/>
  <assign name="def:NumberHex" fore="#b48ead"/>
  <assign name="def:NumberBin" fore="#b48ead"/>
  <assign name="def:NumberOct" fore="#b48ead"/>
  <assign name="def:NumberFloat" fore="#b48ead"/>
  <assign name="def:NumberSuffix" fore="#b48ead"/>
  <assign name="def:NumberPrefix" fore="#b48ead"/>

  <assign name="def:String" fore="#a3be8c"/>
  <assign name="def:StringContent" fore="#ebcb8b"/>
  <assign name="def:StringEdge" fore="#a3be8c"/>
  <assign name="def:Character" fore="#a3be8c"/>
  <assign name="def:CharacterContent" fore="#a3be8c"/>

  <assign name="def:Comment" fore="#616e88" style='2'/>
  <assign name="def:CommentContent" fore="#7b88a1" style='2'/>
  <assign name="def:CommentEdge" fore="#616e88"/>
  <assign name="def:LineComment" fore="#616e88" style='2'/>
  <assign name="def:CommentDoc" fore="#7b88a1" style='2'/>
  <assign name="def:CommentDocContent" fore="#7b88a1" style='2'/>
  <assign name="def:CommentDocEdge" fore="#7b88a1"/>

  <assign name="def:Symbol" fore="#eceff4"/>
  <assign name="def:SymbolStrong" fore="#88c0d0"/>
  <assign name="def:Prefix" fore="#5e81ac"/>
  <assign name="def:PrefixStrong" fore="#5e81ac"/>
  <assign name="def:Operator" fore="#81a1c1"/>

  <assign name="def:Keyword" fore="#81a1c1"/>
  <assign name="def:KeywordStrong" fore="#81a1c1"/>
  <assign name="def:FunctionKeyword" fore="#88c0d0"/>
  <assign name="def:DeprecatedKeyword" fore="#616e88" style='4'/>
  <assign name="def:InterfaceKeyword" fore="#8fbcbb"/>
  <assign name="def:ClassKeyword" fore="#8fbcbb"/>
  <assign name="def:StructKeyword" fore="#8fbcbb"/>
  <assign name="def:TypeKeyword" fore="#8fbcbb"/>

  <assign name="def:Function" fore="#88c0d0"/>
  <assign name="def:Register" fore="#b48ead"/>
  <assign name="def:Constant" fore="#b48ead"/>
  <assign name="def:BooleanConstant" fore="#81a1c1"/>
  <assign name="def:Var" fore="#d8dee9"/>
  <assign name="def:VarStrong" fore="#d08770"/>
  <assign name="def:Identifier" fore="#d8dee9"/>

  <assign name="def:Directive" fore="#5e81ac"/>
  <assign name="def:DirectiveContent" fore="#5e81ac"/>
  <assign name="def:DirectiveEdge" fore="#5e81ac"/>
  <assign name="def:Parameter" fore="#d8dee9"/>
  <assign name="def:ParameterStrong" fore="#d8dee9"/>
  <assign name="def:ParameterUnknown" fore="#bf616a"/>

  <assign name="def:Tag" fore="#81a1c1"/>
  <assign name="def:OpenTag" fore="#81a1c1"/>
  <assign name="def:CloseTag" fore="#81a1c1"/>
  <assign name="def:EmbeddedTag" fore="#8fbcbb"/>

  <assign name="def:Label" fore="#88c0d0"/>
  <assign name="def:LabelStrong" fore="#2e3440" back="#ebcb8b"/>

  <assign name="def:Insertion" fore="#d8dee9" back="#3b4252"/>
  <assign name="def:InsertionStart" fore="#81a1c1" back="#ebcb8b"/>
  <assign name="def:InsertionEnd" fore="#81a1c1" back="#ebcb8b"/>
  <assign name="def:InsertionEmbed" fore="#d8dee9" back="#3b4252"/>

  <assign name="def:Error" fore="#eceff4" back="#bf616a" style='1'/>
  <assign name="def:ErrorText" fore="#bf616a"/>
  <assign name="def:TODO" fore="#2e3440" back="#ebcb8b" style='1'/>
  <assign name="def:Debug" fore="#2e3440" back="#88c0d0"/>

  <assign name="def:URI" fore="#88c0d0" style='4'/>
  <assign name="def:URL" fore="#88c0d0" style='4'/>
  <assign name="def:Path" fore="#a3be8c"/>
  <assign name="def:EMail" fore="#88c0d0" style='4'/>

  <assign name="def:Date" fore="#b48ead"/>
  <assign name="def:Time" fore="#b48ead"/>

  <assign name="def:PairStart" fore="#eceff4" back="#434c5e"/>
  <assign name="def:PairEnd" fore="#eceff4" back="#434c5e"/>
  <assign name="def:PairStrongStart" fore="#2e3440" back="#88c0d0"/>
  <assign name="def:PairStrongEnd" fore="#2e3440" back="#88c0d0"/>
</hrd>
