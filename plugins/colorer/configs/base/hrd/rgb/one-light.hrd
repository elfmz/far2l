<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hrd PUBLIC "-//Cail Lomecb//DTD Colorer HRD take5//EN"
  "http://colorer.sf.net/2003/hrd.dtd">
<hrd xmlns="http://colorer.sf.net/2003/hrd">
  <documentation>
    Atom One Light.
  </documentation>

  <assign name="def:Text" fore="#383a42" back="#fafafa"/>
  <assign name="def:HorzCross" fore="#383a42" back="#f0f0f0"/>
  <assign name="def:VertCross" fore="#383a42" back="#f0f0f0"/>

  <assign name="def:Number" fore="#986801"/>
  <assign name="def:NumberDec" fore="#986801"/>
  <assign name="def:NumberHex" fore="#986801"/>
  <assign name="def:NumberBin" fore="#986801"/>
  <assign name="def:NumberOct" fore="#986801"/>
  <assign name="def:NumberFloat" fore="#986801"/>
  <assign name="def:NumberSuffix" fore="#986801"/>
  <assign name="def:NumberPrefix" fore="#986801"/>

  <assign name="def:String" fore="#50a14f"/>
  <assign name="def:StringContent" fore="#0184bc"/>
  <assign name="def:StringEdge" fore="#50a14f"/>
  <assign name="def:Character" fore="#50a14f"/>
  <assign name="def:CharacterContent" fore="#50a14f"/>

  <assign name="def:Comment" fore="#a0a1a7" style='2'/>
  <assign name="def:CommentContent" fore="#696c77" style='2'/>
  <assign name="def:CommentEdge" fore="#a0a1a7"/>
  <assign name="def:LineComment" fore="#a0a1a7" style='2'/>
  <assign name="def:CommentDoc" fore="#696c77" style='2'/>
  <assign name="def:CommentDocContent" fore="#696c77" style='2'/>
  <assign name="def:CommentDocEdge" fore="#696c77"/>

  <assign name="def:Symbol" fore="#383a42"/>
  <assign name="def:SymbolStrong" fore="#a626a4"/>
  <assign name="def:Prefix" fore="#0184bc"/>
  <assign name="def:PrefixStrong" fore="#0184bc"/>
  <assign name="def:Operator" fore="#0184bc"/>

  <assign name="def:Keyword" fore="#a626a4"/>
  <assign name="def:KeywordStrong" fore="#a626a4"/>
  <assign name="def:FunctionKeyword" fore="#4078f2"/>
  <assign name="def:DeprecatedKeyword" fore="#a0a1a7" style='4'/>
  <assign name="def:InterfaceKeyword" fore="#c18401"/>
  <assign name="def:ClassKeyword" fore="#c18401"/>
  <assign name="def:StructKeyword" fore="#c18401"/>
  <assign name="def:TypeKeyword" fore="#c18401"/>

  <assign name="def:Function" fore="#4078f2"/>
  <assign name="def:Register" fore="#986801"/>
  <assign name="def:Constant" fore="#986801"/>
  <assign name="def:BooleanConstant" fore="#986801"/>
  <assign name="def:Var" fore="#e45649"/>
  <assign name="def:VarStrong" fore="#e45649"/>
  <assign name="def:Identifier" fore="#e45649"/>

  <assign name="def:Directive" fore="#a626a4"/>
  <assign name="def:DirectiveContent" fore="#a626a4"/>
  <assign name="def:DirectiveEdge" fore="#a626a4"/>
  <assign name="def:Parameter" fore="#e45649"/>
  <assign name="def:ParameterStrong" fore="#e45649"/>
  <assign name="def:ParameterUnknown" fore="#e45649"/>

  <assign name="def:Tag" fore="#e45649"/>
  <assign name="def:OpenTag" fore="#e45649"/>
  <assign name="def:CloseTag" fore="#e45649"/>
  <assign name="def:EmbeddedTag" fore="#a626a4"/>

  <assign name="def:Label" fore="#4078f2"/>
  <assign name="def:LabelStrong" fore="#fafafa" back="#c18401"/>

  <assign name="def:Insertion" fore="#383a42" back="#f0f0f0"/>
  <assign name="def:InsertionStart" fore="#a626a4" back="#c18401"/>
  <assign name="def:InsertionEnd" fore="#a626a4" back="#c18401"/>
  <assign name="def:InsertionEmbed" fore="#383a42" back="#f0f0f0"/>

  <assign name="def:Error" fore="#fafafa" back="#e45649" style='1'/>
  <assign name="def:ErrorText" fore="#e45649"/>
  <assign name="def:TODO" fore="#fafafa" back="#c18401" style='1'/>
  <assign name="def:Debug" fore="#fafafa" back="#0184bc"/>

  <assign name="def:URI" fore="#4078f2" style='4'/>
  <assign name="def:URL" fore="#4078f2" style='4'/>
  <assign name="def:Path" fore="#50a14f"/>
  <assign name="def:EMail" fore="#4078f2" style='4'/>

  <assign name="def:Date" fore="#986801"/>
  <assign name="def:Time" fore="#986801"/>

  <assign name="def:PairStart" fore="#383a42" back="#e5e5e6"/>
  <assign name="def:PairEnd" fore="#383a42" back="#e5e5e6"/>
  <assign name="def:PairStrongStart" fore="#fafafa" back="#4078f2"/>
  <assign name="def:PairStrongEnd" fore="#fafafa" back="#4078f2"/>
</hrd>
